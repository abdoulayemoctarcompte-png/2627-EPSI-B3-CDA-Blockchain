{
  "name": "tracelot",
  "private": true,
  "version": "1.0.0",
  "description": "TraceLot : registre de traçabilité de lots sur Ethereum. Projet final du module Développement Blockchain (BLOE562).",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
